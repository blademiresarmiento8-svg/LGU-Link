# Copy this file to .env (same folder, project root) and fill in your real
# SMTP credentials. .env is gitignored, so it never gets committed.
#
# Without a valid .env, the appointment workflow still works end-to-end —
# emails just silently don't send (see config/mail.php / includes/mailer.php).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Pusher Channels (optional) — makes the notification bell update instantly.
# Create an app at https://dashboard.pusher.com (cluster ap1 = Singapore).
# Without these, the bell still works; it just refreshes on page load.
PUSHER_APP_ID=your-app-id
PUSHER_KEY=your-key
PUSHER_SECRET=your-secret
PUSHER_CLUSTER=ap1

# Public address of the portal (used for links inside emails). Change this
# when the site goes live; the default is the local XAMPP address.
APP_URL=http://localhost/LGU-Link

# Email sending pace for news and announcement emails to subscribers. The defaults suit a free Gmail
# account (about 500 recipients a day). Raise them after moving to a larger email service.
MAIL_MAX_PER_MINUTE=30
MAIL_MAX_PER_DAY=400
# Address the emails come from. Leave empty with Gmail (it uses the SMTP_USER login). A service such as
# Amazon SES needs a verified sender address here.
MAIL_FROM_ADDRESS=
